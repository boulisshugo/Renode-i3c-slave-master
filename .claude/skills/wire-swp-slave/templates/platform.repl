// Minimal SWP platform: a CLF master with one proprietary target on SWP line 0.
//
//   (machine) swp PowerUp            // drives S1 - no handshake, no bytes
//   (machine) swp TransferHex "0102"

// No address: the CLF is a separate chip with no register map, so it registers on the sysbus
// without claiming any address space. The monitor still reaches it as sysbus.swp.
swp: SWP.SimpleSWPController @ sysbus

// SWP is point to point - no line index. A second interface is a second controller.
uicc: SWP.MyProprietarySWPSlave @ swp

// ---------------------------------------------------------------------------------------------
// Firmware-managed variant: the target is registered on BOTH the sysbus (memory-mapped registers
// the CPU firmware drives) and the SWP line (so the CLF can reach it). Needs the class to implement
// IDoubleWordPeripheral and IKnownSize as well. This is the arrangement in which the protocol most
// naturally lives in firmware - which is where it lives on real silicon.
// ---------------------------------------------------------------------------------------------
//
// mem: Memory.MappedMemory @ sysbus 0x80000000
//     size: 0x100000
//
// cpu: CPU.RiscV32 @ sysbus
//     cpuType: "rv32imac"
//     timeProvider: clint
//
// clint: IRQControllers.CoreLevelInterruptor @ sysbus 0x02000000
//     frequency: 1000000
//     [0, 1] -> cpu@[3, 7]
//
// uicc: SWP.MyFirmwareManagedUicc @ {
//         sysbus 0x90000000;
//         swp
//     }
