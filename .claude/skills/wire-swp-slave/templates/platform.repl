// Minimal SWP platform: a CLF master with one proprietary UICC on SWP interface 0.
// SWP is a single wire, point to point - the index just selects which interface of this CLF.
//
//   (machine) swp Activate 0
//   (machine) swp SendHex 0 "0102"

// No address: the CLF is a separate chip with no register map, so it registers on the sysbus
// without claiming any address space. The monitor still reaches it as sysbus.swp.
swp: SWP.SimpleSWPController @ sysbus

uicc: SWP.MyProprietarySWPSlave @ swp 0

// ---------------------------------------------------------------------------------------------
// Firmware-managed variant - the one that matches real silicon, where the ACT and SHDLC layers run
// in the target's firmware rather than in the model. The UICC is registered on BOTH the sysbus
// (the register window the CPU firmware drives) and the SWP interface (so the CLF can reach it).
//
// SWP.InventedSWPTarget is usable as-is; the work is the firmware. See firmware-swp/main.c for a
// complete LLC layer in C, and tests/peripherals/SWP-firmware.repl for this platform filled in.
// ---------------------------------------------------------------------------------------------
//
// mem: Memory.MappedMemory @ sysbus 0x80000000
//     size: 0x100000
//
// uart: UART.MiV_CoreUART @ sysbus 0x70001000
//     clockFrequency: 66000000
//
// cpu: CPU.RiscV32 @ sysbus
//     cpuType: "rv32imac"
//     timeProvider: clint
//
// clint: IRQControllers.CoreLevelInterruptor @ sysbus 0x02000000
//     frequency: 1000000
//     [0, 1] -> cpu@[3, 7]
//
// uicc: SWP.InventedSWPTarget @ {
//         sysbus 0x90000000;
//         swp 0
//     }
